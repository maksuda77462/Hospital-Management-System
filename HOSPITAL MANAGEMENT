//================ ADD PATIENT ==================

void addPatient()
{
    printf("\n===== Add New Patient =====\n");
    
    printf("Patient ID: ");
    scanf("%d",&patients[patientCount].patientID);

    printf("Patient Name: ");
    scanf(" %[^\n]",patients[patientCount].name);

    printf("Age: ");
    scanf("%d",&patients[patientCount].age);

    printf("Disease: ");
    scanf(" %[^\n]",patients[patientCount].disease);

    printf("Blood Group (e.g., A+, B-, O+): ");
    scanf(" %[^\n]",patients[patientCount].bloodGroup);

    printf("Phone Number: ");
    scanf(" %[^\n]",patients[patientCount].phoneNumber);
    printf("Gender: ");
    scanf(" %[^\n]", patients[patientCount].gender);

    printf("Address: ");
    scanf(" %[^\n]", patients[patientCount].address);
    printf("Appointment Date: ");
    scanf(" %[^\n]", patients[patientCount].appointmentDate);
    printf("Appointment Time: ");
    scanf(" %[^\n]", patients[patientCount].appointmentTime);

    patientCount++;

    printf("\n✓ Patient Added Successfully!\n");
}

//================ VIEW PATIENT ==================

void viewPatients()
{
    int i;

    if(patientCount==0)
    {
        printf("\nNo Patient Found!\n");
        return;
    }

    printf("\n========== Patient List ==========\n");

    for(i=0;i<patientCount;i++)
    {
        printf("\n--- Patient %d ---\n",i+1);
        printf("ID           : %d\n",patients[i].patientID);
        printf("Name         : %s\n",patients[i].name);
        printf("Age          : %d\n",patients[i].age);
        printf("Disease      : %s\n",patients[i].disease);
        printf("Blood Group  : %s\n",patients[i].bloodGroup);
        printf("Phone        : %s\n",patients[i].phoneNumber);
        printf("Gender       : %s\n", patients[i].gender);
        printf("Address      : %s\n", patients[i].address);
        printf("Appointment Date: %s\n", patients[i].appointmentDate);
        printf("Appointment Time: %s\n", patients[i].appointmentTime);
        printf("----------------------\n");
    }
}

//================ SEARCH PATIENT ==================

void searchPatient()
{
    int id,i,found=0;

    printf("Enter Patient ID to Search: ");
    scanf("%d",&id);

    for(i=0;i<patientCount;i++)
    {
        if(patients[i].patientID==id)
        {
            printf("\n✓ Patient Found\n");
            printf("========================\n");
            printf("ID           : %d\n",patients[i].patientID);
            printf("Name         : %s\n",patients[i].name);
            printf("Age          : %d\n",patients[i].age);
            printf("Disease      : %s\n",patients[i].disease);
            printf("Blood Group  : %s\n",patients[i].bloodGroup);
            printf("Phone        : %s\n",patients[i].phoneNumber);
            printf("Gender       : %s\n", patients[i].gender);
            printf("Address      : %s\n", patients[i].address);
            printf("Appontment Date      : %s\n", patients[i].appointmentDate);
            printf("Appointment time      : %s\n", patients[i].appointmentTime);   
            printf("========================\n");

            found=1;
            break;
        }
    }

    if(found==0)
    {
        printf("\n✗ Patient Not Found!\n");
    }
}

