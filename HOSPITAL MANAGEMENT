#include <stdio.h>
#include <string.h>

#define MAX 100

// Patient Structure
struct Patient
{

    int patientID;
    char name[50];
    int age;
    char gender[10];
    char address[100];
    char disease[50];
    char bloodGroup[5];
    char phoneNumber[15];
    char appointmentDate[20];
    char appointmentTime[20];
    
};

// Doctor Structure
struct Doctor
{
    
    int doctorID;
    char name[50];
    int age;
    char qualification[50];
    char specialization[50];
    char dutyDay[20];
    char dutyTime[20];
    char schedule[50];
    char visitingHours[30];
    char available[10];
    
};

// Arrays
struct Patient patients[MAX];
struct Doctor doctors[MAX];

// Counters
int patientCount = 0;
int doctorCount = 0;

// Function Prototypes
void patientMenu();
void doctorMenu();

void addPatient();
void viewPatients();
void searchPatient();

void addDoctor();
void viewDoctors();
void searchDoctor();

int main()
{
    int choice;

    while(1)
    {
        printf("\n=====================================\n");
        printf("   HOSPITAL MANAGEMENT SYSTEM\n");
        printf("=====================================\n");

        printf("1. Patient Management\n");
        printf("2. Doctor Management\n");
        printf("3. Exit\n");

        printf("Enter Your Choice: ");
        scanf("%d",&choice);

        switch(choice)
        {
            case 1:
                patientMenu();
                break;

            case 2:
                doctorMenu();
                break;

            case 3:
                printf("\nThank You!\n");
                return 0;

            default:
                printf("\nInvalid Choice!\n");
        }
    }
}

//================ PATIENT MENU ==================

